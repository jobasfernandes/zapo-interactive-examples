# Copy to .env and adjust. Every variable is optional.

# SQLite file that keeps the paired session (never commit it).
AUTH_PATH=.auth/session.sqlite
# Session id inside that file; change it to keep several sessions in one file.
SESSION_ID=default

# Phone numbers (digits with country code, comma separated) allowed to use the bot in private chats.
# Empty: only you (the paired account) can trigger commands.
ALLOWED_NUMBERS=
# Group JIDs (comma separated) where the bot answers allowed numbers. Use /groups to list yours.
ALLOWED_GROUPS=

# zapo-js log level: trace, debug, info, warn, error.
LOG_LEVEL=warn

# Link used by cta_url buttons and carousel cards.
CTA_URL=https://github.com/vinikjkkj/zapo
# Page opened by the webview example.
WEBVIEW_URL=https://github.com/vinikjkkj/zapo
# Image used as header of the generic carousel cards.
IMAGE_URL=https://placehold.co/640x640/png
# Number dialed by the cta_call button (with +country code). Empty: the paired account's own number.
CTA_CALL_NUMBER=

# PIX key used by /pix and /charge. The default is the zapo author's key, shared with his permission.
PIX_KEY=+5511982905991
# EVP, EMAIL, PHONE, CPF or CNPJ.
PIX_KEY_TYPE=PHONE
# Name shown as "requested by" on the PIX cards.
PIX_MERCHANT_NAME=vinikjkkj (zapo)
