# Copy to .env and adjust. Every variable is optional.

# SQLite file that keeps the paired session (never commit it).
AUTH_PATH=.auth/session.sqlite
# Session id inside that file; change it to keep several sessions in one file.
SESSION_ID=default

# Phone numbers (digits with country code, comma separated) allowed to use the bot in private chats.
# Empty: only you (the paired account) can trigger commands.
ALLOWED_NUMBERS=
# Group JIDs (comma separated) where the bot answers allowed numbers, and the only groups
# /group-status posts to. Use /groups to list yours.
ALLOWED_GROUPS=

# zapo-js log level: trace, debug, info, warn, error.
LOG_LEVEL=warn

# Link used by cta_url buttons and carousel cards.
CTA_URL=https://github.com/vinikjkkj/zapo
# Page opened by the webview example.
WEBVIEW_URL=https://github.com/vinikjkkj/zapo
# Image used as header of the generic carousel cards.
IMAGE_URL=https://placehold.co/640x640/png
# Number dialed by the cta_call button (with +country code). Empty: the paired account's own number.
CTA_CALL_NUMBER=

# PIX key used by /pix and /charge. The default is the zapo author's key, shared with his permission.
PIX_KEY=+5511982905991
# EVP, EMAIL, PHONE, CPF or CNPJ.
PIX_KEY_TYPE=PHONE
# Name shown as "requested by" on the PIX cards.
PIX_MERCHANT_NAME=vinikjkkj (zapo)

# Experimental, off by default. true sends a 👋 and then marks the first message to each private
# chat as hosted by Meta, so the contact's WhatsApp shows "This business is now using a secure
# service from Meta to manage this chat". Read "Meta-Hosted Banner" in README.md before turning it on.
META_HOSTED_BANNER=false

# Optional. Put before the first /ai question of each conversation, because Meta AI has no system
# prompt field. Empty: none. Meta AI picks the answer language by itself; to pin it use, for
# example: Reply in the same language the question is written in, even if your default language is
# different: an English question gets an English answer and a Portuguese question gets a Portuguese answer.
# A longer prompt (a name for the assistant, what the bot does, its commands) can span several lines
# if the value is wrapped in double quotes, with no double quote inside it. Never put a secret in it:
# Meta AI shares what it remembers between the chats of the paired account.
AI_SYSTEM_PROMPT=
