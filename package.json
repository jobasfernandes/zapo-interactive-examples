{
    "name": "zapo-interactive-examples",
    "version": "0.1.0",
    "private": true,
    "description": "Real WhatsApp interactive message examples (buttons, carousel, A2UI form, webview, catalog, orders) with zapo-js, plus a test bot",
    "license": "Unlicense",
    "type": "module",
    "engines": {
        "node": ">=20.12"
    },
    "scripts": {
        "start": "tsx src/bot/main.ts",
        "send": "tsx src/cli/send.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@zapo-js/store-sqlite": "^1.3.0",
        "better-sqlite3": "^12.6.2",
        "qrcode-terminal": "^0.12.0",
        "ws": "^8.20.1",
        "zapo-js": "^1.10.0"
    },
    "devDependencies": {
        "@types/node": "^22.13.14",
        "tsx": "^4.20.6",
        "typescript": "^5.7.3",
        "vitest": "^5.0.5"
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true,
        "esbuild@0.28.2": true,
        "zapo-js@1.10.0": true
    }
}
